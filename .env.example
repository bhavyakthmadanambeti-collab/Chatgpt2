# GEMINI_API_KEY: Required for Gemini AI API calls and native Google Search Grounding.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# JWT_SECRET: Secret key for signing user session tokens
JWT_SECRET="chatgpt_pro_secret_key_2026_super_secure"

# OLLAMA_URL: Local Ollama instance URL (default: http://127.0.0.1:11434)
OLLAMA_URL="http://127.0.0.1:11434"

# SEARXNG_URL: Self-hosted SearXNG search engine URL (default: http://localhost:8080)
SEARXNG_URL="http://localhost:8080"

# Optional external cloud AI providers:
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional Google Programmable Search credentials:
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""
